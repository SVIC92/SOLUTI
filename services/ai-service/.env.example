# Conexión a la misma base Neon Postgres que usa el backend (pooler + TLS)
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxxx-pooler.neon.tech/dbname?ssl=require

# Cola de eventos compartida con el backend Node
REDIS_URL=redis://redis:6379

# Backend Node — para escribir de vuelta clasificación/asignación en el ticket
BACKEND_URL=http://backend:3000/api/v1

# Motor LLM (Gemini)
GEMINI_API_KEY=changeme
GEMINI_MODEL_FAST=gemini-flash-latest
GEMINI_MODEL_PRO=gemini-pro-latest

# Modelo de embeddings local (no sale de la red interna)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIM=1024

# Auth interna entre backend <-> ai-service (API key compartida o mTLS)
AI_SERVICE_API_KEY=changeme

# Umbrales de confianza (por debajo, no se autoaplica; se marca para revisión humana)
TRIAGE_CONFIDENCE_THRESHOLD=0.7

LOG_LEVEL=info
