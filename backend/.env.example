NODE_ENV=development
PORT=3000

# Neon Postgres — usar el endpoint pooler (termina en "-pooler") para no agotar
# conexiones desde el server on-premise. sslmode=require es obligatorio en Neon.
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.neon.tech/dbname?sslmode=require

JWT_ACCESS_SECRET=changeme-genera-un-secreto-largo-y-aleatorio
JWT_REFRESH_SECRET=changeme-otro-secreto-distinto-al-anterior

SMTP_HOST=smtp.empresa.local
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=helpdesk@empresa.local

REDIS_URL=redis://redis:6379

AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_API_KEY=changeme-mismo-valor-que-ai-service/.env

FRONTEND_URL=http://localhost:4200
STORAGE_DRIVER=local

# --- SSO por Active Directory / LDAP (opcional) -----------------------------
# Deja LDAP_URL vacío para desactivar el botón de "Inicio de sesión corporativo"
# en el login — /auth/login/ldap responde 503 sin romper el resto del sistema.
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
LDAP_TLS_REJECT_UNAUTHORIZED=true

# --- Portal Multi-canal (opcional, por canal) -------------------------------
# WhatsApp Cloud API (Meta): https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Slack app con Events API habilitada
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Bot de Microsoft Teams (Bot Framework)
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
